# ========================================================
# CloudOps AI — Production Environment Configuration Template
# ========================================================
# Copy this file to .env and configure the variables:
#   cp server/.env.example server/.env
#
# SECURITY: NEVER commit real credentials or .env into Git.
# ========================================================

# --------------------------------------------------------
# 1. Server Environment
# --------------------------------------------------------
NODE_ENV=production
PORT=5000
CLIENT_URL=https://cloudops-ai-frontend-project.onrender.com

# --------------------------------------------------------
# 2. MongoDB Database
# --------------------------------------------------------
# Set your MongoDB connection URI (e.g. MongoDB Atlas or self-hosted)
# Both MONGODB_URI and MONGO_URI are supported.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cloudops?retryWrites=true&w=majority

# --------------------------------------------------------
# 3. Authentication & Security
# --------------------------------------------------------
# Generate a cryptographically secure random string (at least 32 characters)
# Command: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_min_32_characters_random_hex

# --------------------------------------------------------
# 4. AI Engine Configuration (OpenRouter & Gemini)
# --------------------------------------------------------
# Select active AI provider: "openrouter" (default) or "gemini"
AI_PROVIDER=openrouter

# OpenRouter Configuration (OpenAI-compatible chat completions)
# Endpoint: https://openrouter.ai/api/v1/chat/completions
# Model defaults to "openrouter/free" or specify any OpenRouter model ID
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Google Gemini API (Alternative AI Provider)
# Set AI_PROVIDER=gemini to use Gemini instead of OpenRouter
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_EMBED_MODEL=text-embedding-004

# Set to true for automated test/mock mode without calling live external API:
# AI_MOCK=false
# GEMINI_MOCK=false

# Optional legacy fallback: local Ollama instance (used only if AI providers are not configured)
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# --------------------------------------------------------
# 5. Alerting & Webhook Security
# --------------------------------------------------------
# Shared secret for authenticating incoming Alertmanager / Grafana Cloud webhooks
# Webhooks must provide this secret via:
#   - Header 'X-Webhook-Token: <secret>'
#   - Header 'Authorization: Bearer <secret>'
#   - Query parameter '?token=<secret>'
ALERTMANAGER_WEBHOOK_SECRET=your_secure_alertmanager_webhook_secret_here

# Internal Alertmanager URL (for Docker Compose local development)
ALERTMANAGER_URL=http://alertmanager:9093

# --------------------------------------------------------
# 6. Observability & Grafana Cloud Integration
# --------------------------------------------------------
# Local Prometheus (default for Docker Compose local development)
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000

# Grafana Cloud Prometheus Metrics (Production on Render)
# Set these on Render backend to query Grafana Cloud Prometheus:
# GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX-prod-us-central-0.grafana.net/api/prom
# GRAFANA_CLOUD_PROMETHEUS_USERNAME=123456
# GRAFANA_CLOUD_PROMETHEUS_TOKEN=glc_your_token_with_metrics_read_permission

# Grafana Cloud Remote Write (Used by Prometheus or Grafana Alloy to ship metrics to Grafana Cloud)
# GRAFANA_CLOUD_REMOTE_WRITE_URL=https://prometheus-prod-XX-prod-us-central-0.grafana.net/api/prom/push
# GRAFANA_CLOUD_USER=123456
# GRAFANA_CLOUD_API_KEY=glc_your_token_with_metrics_write_permission

# --------------------------------------------------------
# 7. Automatic Incident Intelligence Engine
# --------------------------------------------------------
INCIDENT_DETECTION_ENABLED=true
INCIDENT_DETECTION_INTERVAL_SECONDS=30
INCIDENT_CONSECUTIVE_BREACHES=2

# --------------------------------------------------------
# 8. CORS & Frontend Origin Settings
# --------------------------------------------------------
# Comma-separated list of allowed origins for browser access
CORS_ORIGINS=https://cloudops-ai-frontend-project.onrender.com,http://localhost:5173,http://localhost:3000

# --------------------------------------------------------
# 9. Kubernetes Orchestration
# --------------------------------------------------------
# In Render public deployment, Kubernetes telemetry and operations run
# via the registered outbound-only CloudOps Agent (minikube/remote cluster).
KUBERNETES_ENABLED=true
KUBERNETES_NAMESPACE=cloudops
