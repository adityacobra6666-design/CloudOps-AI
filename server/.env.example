# ========================================================
# CloudOps AI — Environment Configuration Template
# ========================================================
# Copy this file to .env and fill in the values:
#   cp server/.env.example server/.env
#
# NEVER commit .env with real credentials into version control.
# ========================================================

# --------------------------------------------------------
# 1. Server Environment
# --------------------------------------------------------
# Set to 'production' for public deployments, 'development' for local
NODE_ENV=production
PORT=5000

# --------------------------------------------------------
# 2. MongoDB Database
# --------------------------------------------------------
# Both MONGO_URI and MONGODB_URI are supported.
# For Docker Compose internal network: mongodb://mongo:27017/cloudops
# For MongoDB Atlas / Managed MongoDB: mongodb+srv://<user>:<password>@cluster.mongodb.net/cloudops
MONGO_URI=mongodb://mongo:27017/cloudops
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cloudops

# --------------------------------------------------------
# 3. Authentication & Security
# --------------------------------------------------------
# Generate a cryptographically secure random string (at least 32 characters)
# Example command: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_change_in_production_min_32_chars

# --------------------------------------------------------
# 4. Ollama AI / LLM & RAG Embeddings
# --------------------------------------------------------
# Internal service URL within Docker Compose network
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# --------------------------------------------------------
# 5. Monitoring & Observability Pipeline
# --------------------------------------------------------
# Local Prometheus (Default for local development)
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
ALERTMANAGER_URL=http://alertmanager:9093

# Grafana Cloud Prometheus (Production on Render)
# When set, the backend securely queries Grafana Cloud Prometheus using HTTP Basic Auth.
# NOTE: Credentials reside strictly on the backend and are NEVER exposed to the frontend.
# GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX-prod-us-central-0.grafana.net/api/prom
# GRAFANA_CLOUD_PROMETHEUS_USERNAME=123456
# GRAFANA_CLOUD_PROMETHEUS_TOKEN=glc_your_token_here

# Grafana admin credentials (change in production)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change_admin_password_in_production

# --------------------------------------------------------
# 6. CORS & Frontend Origin Settings
# --------------------------------------------------------
# Comma-separated list of allowed origins.
# In production behind Nginx reverse proxy, frontend and API share the same origin,
# but include your public domain here for external API consumers.
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,https://your-domain.com

# Public URL used in email reset links and notifications
FRONTEND_PUBLIC_URL=http://localhost

# --------------------------------------------------------
# 7. Kubernetes Orchestration & Remediation
# --------------------------------------------------------
# Set to true when connected to a cluster, false to disable K8s features
KUBERNETES_ENABLED=true
KUBERNETES_NAMESPACE=cloudops

# Optional: Path to custom kubeconfig (if connecting to external cluster)
# KUBECONFIG=/root/.kube/config

# Optional: Kubernetes server host override for Docker networking
# KUBERNETES_SERVER_HOST=host.docker.internal
# KUBERNETES_SKIP_TLS=true
