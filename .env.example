# ========================================================
# CloudOps AI — Root Docker Compose & Deployment Environment
# ========================================================

# --------------------------------------------------------
# Node & Server Settings
# --------------------------------------------------------
NODE_ENV=production
PORT=5000
CLIENT_URL=https://cloudops-ai-frontend-project.onrender.com
JWT_SECRET=your_jwt_secret_min_32_characters_random_hex
MONGODB_URI=mongodb://mongo:27017/cloudops

# --------------------------------------------------------
# AI Engine Configuration (OpenRouter & Gemini)
# --------------------------------------------------------
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Google Gemini API (Alternative AI Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_EMBED_MODEL=text-embedding-004

# --------------------------------------------------------
# Alerting Webhook Secret
# --------------------------------------------------------
ALERTMANAGER_WEBHOOK_SECRET=your_secure_alertmanager_webhook_secret_here

# --------------------------------------------------------
# Grafana Cloud Integration (Metrics & Remote Write)
# --------------------------------------------------------
# Obtain connection details from:
#   Grafana.com -> Cloud Portal -> Your Stack -> Prometheus "Details"
#
# Option A: Single Access Policy with BOTH scopes (Recommended)
# Create an Access Policy in Grafana Cloud with scopes:
#   - metrics:write (needed for Prometheus remote_write pushing samples)
#   - metrics:read  (needed for Backend PromQL telemetry querying)
# Then use the same instance ID and token for both:
#
# GRAFANA_CLOUD_REMOTE_WRITE_URL=https://prometheus-prod-XX-prod-us-central-0.grafana.net/api/prom/push
# GRAFANA_CLOUD_USER=123456
# GRAFANA_CLOUD_API_KEY=glc_your_token_with_metrics_write_and_read
#

# Grafana Cloud Prometheus Remote Write
GRAFANA_CLOUD_REMOTE_WRITE_URL=https://your-prometheus-stack.grafana.net/api/prom/push
GRAFANA_CLOUD_USER=YOUR_PROMETHEUS_INSTANCE_ID
GRAFANA_CLOUD_API_KEY=YOUR_METRICS_WRITE_TOKEN

# Grafana Cloud Query Credentials (Backend)
GRAFANA_CLOUD_PROMETHEUS_URL=https://your-prometheus-stack.grafana.net/api/prom
GRAFANA_CLOUD_PROMETHEUS_USERNAME=YOUR_PROMETHEUS_INSTANCE_ID
GRAFANA_CLOUD_PROMETHEUS_TOKEN=YOUR_METRICS_READ_TOKEN

# --------------------------------------------------------
# Local Service URLs
# --------------------------------------------------------
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
ALERTMANAGER_URL=http://alertmanager:9093
KUBERNETES_ENABLED=true
KUBERNETES_NAMESPACE=cloudops
