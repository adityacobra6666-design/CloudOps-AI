# ========================================================
# CloudOps AI Agent — Environment Configuration Template
# ========================================================

# CloudOps Control Plane Endpoint (Outbound HTTPS only)
CLOUDOPS_URL=http://localhost:5000

# One-time Enrollment Token generated from CloudOps AI UI
# (Used on initial startup to enroll and receive AGENT_ID / AGENT_TOKEN)
ENROLLMENT_TOKEN=cope_your_generated_enrollment_token_here

# Operational Credentials (Populated automatically after enrollment)
AGENT_ID=
AGENT_TOKEN=

# Metadata
AGENT_NAME=production-cluster
AGENT_ENVIRONMENT=production

# Local Customer Infrastructure Endpoints (Remains Private)
PROMETHEUS_URL=http://localhost:9090
KUBECONFIG=~/.kube/config

# Polling & Heartbeat Intervals (milliseconds)
HEARTBEAT_INTERVAL_MS=20000
TELEMETRY_INTERVAL_MS=10000
COMMAND_POLL_INTERVAL_MS=5000

# Safety Whitelist Constraints
ALLOWED_NAMESPACES=cloudops,default
MIN_REPLICAS=1
MAX_REPLICAS=10
